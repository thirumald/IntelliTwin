# Copy to .env (git-ignored) and fill in. Never commit real values.
# TomTom key from https://my.tomtom.com/keys (free tier). Leave empty to run on the simulation only.
TOMTOM_KEY=
# Initial admin password (first start only). If empty, a random one is printed once in the server log.
INTELLITWIN_ADMIN_PASSWORD=
# Protect the free quota: max upstream calls per UTC day (data calls / map tiles).
TOMTOM_DAILY_CAP=2000
TOMTOM_TILE_CAP=20000
# Map tiles from TomTom are off. Set to on only if the server may fetch them.
# TOMTOM_TILES=off
# INTELLITWIN_AUTH=off   # kiosk mode without login (everyone is admin)
# PORT=8090

# --- Single sign-on (optional). Default is local users in the app. ---
# INTELLITWIN_AUTH_MODE=oidc
# OIDC_ISSUER=https://sso.example.com/realms/presight
# OIDC_CLIENT_ID=intellitwin
# OIDC_CLIENT_SECRET=
# OIDC_ROLE_CLAIM=realm_access.roles     # Keycloak default; "groups" also works
# OIDC_DEFAULT_ROLE=                     # empty: people without a role are refused
# OIDC_NAME=single sign-on               # text on the button
