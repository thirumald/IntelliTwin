# Copy to .env (git-ignored) and fill in. Never commit real values.
# TomTom key from https://my.tomtom.com/keys (free tier). Leave empty to run on the simulation only.
TOMTOM_KEY=
# Initial admin password (first start only). If empty, a random one is printed once in the server log.
INTELLITWIN_ADMIN_PASSWORD=
# Protect the free quota: max upstream calls per UTC day (data calls / map tiles).
TOMTOM_DAILY_CAP=2000
TOMTOM_TILE_CAP=20000
# INTELLITWIN_AUTH=off   # kiosk mode without login (everyone is admin)
# PORT=8090
